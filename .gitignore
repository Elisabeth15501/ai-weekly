# WorkBuddy 项目数据（绝不提交）
.workbuddy/

# 项目规划与审计文档（本地工作文件，不入库）
AI_Weekly_Optimization_Plan.md
AI_Weekly_Adversarial_Review.md

# 日志
*.log

# 打包后的 skill 构建产物（可由源码重新生成）
ai-weekly.skill

# 临时健康检查报告
*-health-check*.md

# 运行时生成、可重新生成的产物（由脚本自动产出，不入库）
news.json
leaderboard_cache.json
insights.json
audience_summary.json
audience_summary.txt
cn_leaderboard_snapshot.json
keyword_search_sources.json
model_profiles.pending.json
*.run.log

# Python 字节码缓存（构建产物，绝不入库）
__pycache__/
*.pyc

# OpenClaw 独立打包产物（由 tools/build_openclaw_bundle.sh 生成，不入库）
openclaw-edition/scripts/
openclaw-edition/assets/
openclaw-edition/requirements.txt
openclaw-edition/run_report.sh
openclaw-edition/model_profiles.json
